# Google Gmail SMTP for storefront email verification
PAXIG_SMTP_HOST=smtp.gmail.com
PAXIG_SMTP_PORT=587
PAXIG_SMTP_ENCRYPTION=tls
PAXIG_SMTP_USERNAME=your-google-account@gmail.com
PAXIG_SMTP_APP_PASSWORD=replace-with-google-app-password
PAXIG_SMTP_FROM_EMAIL=your-google-account@gmail.com
PAXIG_SMTP_FROM_NAME=PAXIG Shoes
